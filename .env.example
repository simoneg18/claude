# TCG Monitor Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# DISCORD WEBHOOK (Required)
# ===========================================
# Get this from: Discord Server Settings > Integrations > Webhooks
# Create a webhook in the channel where you want to receive notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ===========================================
# OPTIONAL SETTINGS
# ===========================================
# Discord role ID to mention on alerts (leave empty for no mentions)
# To get a role ID: Enable Developer Mode in Discord, right-click the role, Copy ID
DISCORD_ROLE_ID=

# ===========================================
# PROXY CONFIGURATION (Optional - for advanced users)
# ===========================================
# If you're getting blocked, you can use a proxy
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
